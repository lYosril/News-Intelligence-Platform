# ---------------------------------------------------------------------------
# Docker Compose configuration - copy to the repository root as `.env`:
#     cp .env.example .env
# Compose reads this file automatically for ${VAR} interpolation, for BOTH
# compose.yaml (development) and compose.production.yaml (production-style).
# Every value below is a safe development default; never commit a real `.env`.
# Variable names here match the ${...} placeholders in the compose files.
# ---------------------------------------------------------------------------

# --- PostgreSQL (db service) -----------------------------------------------
# NOTE: the values below are used both by the db container and by compose to
# build the backend's DATABASE_URL (service DNS `db:5432`). After the first
# `docker compose up`, changing POSTGRES_PASSWORD does NOT change the password
# inside an existing data volume - see README troubleshooting.
POSTGRES_USER=news
POSTGRES_PASSWORD=dev-only-password
POSTGRES_DB=news_intelligence
# Host-side port for the db service (containers always reach db:5432).
# 5433 avoids clashing with a PostgreSQL already running on this machine.
POSTGRES_PORT=5433

# --- Redis -----------------------------------------------------------------
# Host-side port for the redis service (containers use redis:6379).
REDIS_PORT=6379

# --- Published host ports --------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=5173
# Only used by compose.production.yaml (nginx serves the built SPA here).
WEB_PORT=8080

# --- Django ----------------------------------------------------------------
# Development default only. Required (and must be a real value) for
# compose.production.yaml - generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
# Used by config.settings.development. `backend` is the container DNS name.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Browser origins allowed to call the API cross-origin (development: Vite at
# 5173; production-style: nginx at 8080, which is same-origin but listed for
# direct API access).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# --- Host-run URLs (NOT used inside Docker) --------------------------------
# These two are for running Django/Celery directly on the host (`manage.py`,
# `celery -A config worker`). The compose files deliberately build their own
# service-DNS URLs instead of reading these, so localhost here never leaks
# into a container.
DATABASE_URL=postgresql://news:dev-only-password@localhost:5433/news_intelligence
REDIS_URL=redis://localhost:6379/0

# --- Frontend --------------------------------------------------------------
# What the BROWSER uses to reach the API in development (host port of the
# backend service). Build-time variable baked into the Vite bundle.
VITE_API_BASE_URL=http://localhost:8001
# Production build (compose.production.yaml): EMPTY = same origin, i.e. the
# browser calls /api/v1/... on the page's own host and nginx proxies those to
# the backend service. Set only if the API lives on a different origin.
PROD_VITE_API_BASE_URL=

# --- Production only (compose.production.yaml) -----------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# --- Reserved for Milestone 2 (news ingestion) -----------------------------
# Not read yet; documented so credentials have a known home.
# NEWS_API_KEY=
# NEWS_API_BASE_URL=https://newsapi.org

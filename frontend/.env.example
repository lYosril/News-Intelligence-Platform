# ---------------------------------------------------------------------------
# Frontend environment - copy to frontend/.env for local runs:
#     cp frontend/.env.example frontend/.env
# Vite only exposes variables prefixed with VITE_ to browser code.
# ---------------------------------------------------------------------------

# Base URL of the Django API, as seen FROM THE BROWSER (not from containers).
# Dev (Docker Compose): the backend publishes host port 8001 -> http://localhost:8001
# Set to an empty string to call the same origin the page was loaded from.
VITE_API_BASE_URL=http://localhost:8001

# Vite dev server bind address and port.
# In Docker Compose this is set to 0.0.0.0 so the host browser can reach it.
VITE_HOST=localhost
VITE_PORT=5173

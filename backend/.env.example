# ---------------------------------------------------------------------------
# Backend environment - copy to backend/.env for local (non-Docker) runs:
#     cp backend/.env.example backend/.env
# Never commit backend/.env. All values below are development placeholders.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Development default is an insecure placeholder; production refuses it.
# Generate a real key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=true
# Comma-separated hostnames (no scheme). Include "backend" for container-to-container calls.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated full origins, required for HTTPS admin sessions:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# --- Database ---------------------------------------------------------------
# PostgreSQL connection URL. Host/port must match where PostgreSQL runs.
# Local Docker:  postgresql://news_user:news_pass@localhost:5432/news_intelligence
# In containers Compose rewrites the host to the db service DNS name.
DATABASE_URL=postgresql://news_user:news_pass@localhost:5432/news_intelligence
DATABASE_CONN_MAX_AGE=60

# --- Redis (cache + Celery broker) ------------------------------------------
# Local Docker: redis://localhost:6379/0 ; in containers: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CACHE_KEY_PREFIX=nip

# --- CORS / API -------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=true
API_PAGE_SIZE=25

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Production-only hardening (ignored in development) ---------------------
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_HSTS_SECONDS=0
# DJANGO_COOKIE_SECURE=true
# DJANGO_TRUST_PROXY_SSL_HEADER=false
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Reserved for Milestone 2 (news ingestion) ------------------------------
# Not read by the application yet; documented so credentials have a home.
# NEWS_API_KEY=
# NEWS_API_BASE_URL=https://newsapi.org
# RSS_FEED_URLS=https://example.com/feed.xml
